      ],
      "id": "fc4e09d4-bf87-4c1e-9edb-966b9f121fff",
      "name": "Search Knowledge Base"
    },
    {
      "parameters": {
        "jsCode": "// Get the user's original question\nconst question = $('Webhook').first().json.body.question;\n\n// Get all retrieved chunks\nconst points = $json.result.points;\n\n// Combine all retrieved chunks into one context\nconst context = points\n  .map(point => point.payload.chunk)\n  .join(\"\\n\\n----------------------\\n\\n\");\n\n// Also keep track of the source documents\nconst sources = [\n  ...new Set(points.map(point => point.payload.source))\n];\n\n// Create the prompt for qwen3\nconst prompt = `\nYou are an AI assistant answering questions from the company's knowledge base.\n\nRules:\n1. Answer ONLY from the provided context.\n2. Do NOT make up information.\n3. If the answer is not available in the context, reply:\n\"I couldn't find that information in the knowledge base.\"\n\nContext:\n${context}\n\nQuestion:\n${question}\n\nAnswer:\n`;\n\nreturn [\n  {\n    json: {\n      prompt,\n      sources\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "a794f59c-8df5-459b-9bd0-e7cd6c58c8ae",
      "name": "Build Context"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "qwen3:8b"
            },
            {
              "name": "stream",
              "value": "={{ false }}"
            },
            {
              "name": "messages",
              "value": "={{ [ { role: \"user\", content: $json.prompt } ] }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1040,
        0
      ],
      "id": "a13198ef-6f08-4b87-ac98-8e3e52e9aeb1",
      "name": "Generate AI Response"
    },
    {
      "parameters": {
        "jsCode": "// Get the AI answer from the previous node\nconst answer = $json.message.content;\n\n// Get the sources from the Build Prompt node\nconst sources = $('Build Context').first().json.sources;\n\nreturn [\n  {\n    json: {\n      answer,\n      sources\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
