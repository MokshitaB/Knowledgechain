        "url": "http://host.docker.internal:6333/collections/knowledge_base/points/query",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{$json.embeddings[0]}}"
            },
            {
              "name": "limit",
              "value": "={{ 5 }}"
            },
            {
              "name": "with_payload",
              "value": "={{ true }}"
            }
